  <widget type="multi_state_led" version="2.0.0">
    <name>LED (Multi State)</name>
    <pv_name>ml-nn:ex2:class-out</pv_name>
    <x>676</x>
    <y>182</y>
    <states>
      <state>
        <value>0</value>
        <label>FALLING</label>
        <color>
          <color name="OK" red="65" green="229" blue="65">
          </color>
        </color>
      </state>
      <state>
        <value>1</value>
        <label>STABLE</label>
        <color>
          <color name="MINOR" red="255" green="235" blue="17">
